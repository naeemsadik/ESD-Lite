# Copy this file to .env and put your real key in it. Never commit .env.
OPENAI_API_KEY=sk-...

# Optional overrides
# ESD_CHAT_MODEL=gpt-4o-mini
# ESD_EMBED_MODEL=text-embedding-3-small
# ESD_CARD_TOKEN_BUDGET=300
# Some newer models (e.g. the gpt-5 family) only accept the default temperature.
# For those, set ESD_TEMPERATURE=none
# ESD_TEMPERATURE=0
